---
import Grundlayout from '../layouts/Grundlayout.astro';
import Hero from '../components/Hero.astro';
import Leistungen from '../components/Leistungen.astro';
import DachaufbauExplorer from '../components/DachaufbauExplorer.astro';
import ProjekteVorschau from '../components/ProjekteVorschau.astro';
import KostenrechnerVorschau from '../components/KostenrechnerVorschau.astro';
import Prozess from '../components/Prozess.astro';
import Sturmschaden from '../components/Sturmschaden.astro';
import Einsatzgebiet from '../components/Einsatzgebiet.astro';
import Kontakt from '../components/Kontakt.astro';
---

<Grundlayout
  titel="Dachdecker und Spengler in Augsburg | A&D Bedachungen"
  beschreibung="Dachdeckerei und Spenglerei in Augsburg und Dasing: Steildach, Flachdach, Metallfalzdach, Dachrinnen und Spenglerarbeiten. Mit Kostenrechner."
  heroPoster
>
  <Hero />
  <Leistungen />
  <DachaufbauExplorer />
  <ProjekteVorschau />
  <KostenrechnerVorschau />
  <Prozess />
  <Sturmschaden />
  <Einsatzgebiet />
  <Kontakt />
</Grundlayout>
