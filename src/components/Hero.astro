---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { telLink } from '../data/betrieb';
import foto from '../assets/projekte/walmdach-falz-nachher.jpeg';

/**
 * Ruhiger, einmaliger Auftritt statt Scroll-Scrub: ein Foto, ein Einblenden
 * beim Laden, ein leichter Glanzzug auf dem Blech, und auf Geraeten mit
 * Maus eine kleine Parallaxe, die Foto und Text gegenlaeufig verschiebt.
 * Kein <video>, keine Bildsequenz, kein an den Scroll gekoppelter Wert.
 * Ohne JavaScript und bei prefers-reduced-motion steht ein normaler Hero
 * mit Standbild da, der Inhalt ist in jedem Fall vollstaendig.
 */
---

<section class="hero" data-hero aria-labelledby="hero-titel">
  <div class="hero__bild" data-hero-bild>
    <Image
      src={foto}
      alt="Fertig gedecktes Walmdach im dunklen Doppelstehfalz, Abendlicht auf dem Blech."
      widths={[640, 1100, 1600, 2200]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__foto"
    />
    <div class="hero__glanz" aria-hidden="true"></div>
  </div>

  <div class="hero__schleier" aria-hidden="true"></div>

  <div class="bahn hero__inhalt" data-hero-inhalt>
    <h1 id="hero-titel" class="hero__titel">Dicht ist keine Meinung.</h1>
    <p class="hero__unter">
      Dachdeckerei und Spenglerei in Augsburg. Steildach, Flachdach, Metallfalz und alles,
      was am Dach aus Blech ist.
    </p>
    <div class="hero__aktionen">
      <a class="knopf knopf--patina" href="#kontakt">Anfrage stellen</a>
      <a class="knopf knopf--rand" href={telLink}>
        <Icon name="ph:phone-fill" aria-hidden="true" />
        Anrufen
      </a>
    </div>
  </div>

  <a class="hero__runter" href="#leistungen" aria-label="Zum Inhalt runterscrollen">
    <Icon name="ph:arrow-down" aria-hidden="true" />
  </a>
</section>

<script>
  import { starteHero } from '../scripts/heroInit';
  starteHero();
</script>

<style>
  .hero {
    position: relative;
    height: 100dvh;
    min-height: 32rem;
    overflow: hidden;
    background: var(--color-bitumen);
    isolation: isolate;
  }

  .hero__bild {
    position: absolute;
    inset: 0;
    /* Traegt die Parallaxe. Getrennt vom Zoom auf dem Foto selbst, sonst
       kaempfen zwei Animationen um dieselbe transform-Eigenschaft. */
    transform: translate(calc(var(--zeiger-x, 0) * -16px), calc(var(--zeiger-y, 0) * -16px));
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero__foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    /* Ueberskaliert, damit die Parallaxe des Elternelements nie den Rand
       zeigt. Dazu ein einmaliges, ruhiges Heranzoomen beim ersten Laden. */
    transform: scale(1.06);
    animation: heroZoom 16s ease-out both;
  }

  /* Ein wandernder Lichtstreifen, wie er auf frisch gefalztem Blech
     entlanglaeuft. Rein dekorativ, per Blend-Mode statt eigener Ebene. */
  .hero__glanz {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 42%,
      color-mix(in srgb, var(--color-zinkweiss) 16%, transparent) 50%,
      transparent 58%
    );
    background-size: 260% 260%;
    mix-blend-mode: overlay;
    animation: heroGlanz 11s ease-in-out infinite;
    pointer-events: none;
  }

  .hero__schleier {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-bitumen) 92%, transparent) 0%,
      color-mix(in srgb, var(--color-bitumen) 55%, transparent) 38%,
      color-mix(in srgb, var(--color-bitumen) 12%, transparent) 68%,
      color-mix(in srgb, var(--color-bitumen) 42%, transparent) 100%
    );
    pointer-events: none;
  }

  .hero__inhalt {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    padding-bottom: clamp(5.5rem, 10vh, 7rem);
    transform: translate(calc(var(--zeiger-x, 0) * 6px), calc(var(--zeiger-y, 0) * 6px));
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero__titel,
  .hero__unter,
  .hero__aktionen {
    opacity: 0;
    transform: translateY(20px);
    animation: heroEintritt 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero__titel {
    animation-delay: 0.1s;
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    font-stretch: 118%;
    max-width: 16ch;
    margin-bottom: 1.1rem;
  }
  .hero__unter {
    animation-delay: 0.25s;
    max-width: 46ch;
    color: var(--color-kreide);
    font-size: clamp(1.05rem, 0.98rem + 0.4vw, 1.25rem);
    margin-bottom: 1.9rem;
  }
  .hero__aktionen {
    animation-delay: 0.4s;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__aktionen :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .hero__runter {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--color-zinkweiss) 35%, transparent);
    border-radius: 50%;
    color: var(--color-zinkweiss);
    animation: heroRunter 2.2s ease-in-out infinite;
  }
  .hero__runter:hover {
    border-color: var(--color-patina);
    color: var(--color-patina);
  }
  .hero__runter :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  @media (min-width: 40rem) {
    .hero__runter {
      display: flex;
    }
  }

  @keyframes heroZoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }
  @keyframes heroGlanz {
    0%,
    100% {
      background-position: 120% 0%;
    }
    50% {
      background-position: -20% 100%;
    }
  }
  @keyframes heroEintritt {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes heroRunter {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__bild,
    .hero__inhalt {
      transition: none;
    }
    .hero__bild,
    .hero__foto,
    .hero__glanz,
    .hero__titel,
    .hero__unter,
    .hero__aktionen,
    .hero__runter {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
