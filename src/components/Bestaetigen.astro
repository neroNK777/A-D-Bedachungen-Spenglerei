---
/**
 * Zeigt Text an und loest darin enthaltene [[BESTÄTIGEN: ...]]-Platzhalter
 * zu ihrem Klartext auf, ohne sie optisch zu markieren. Die Seite geht als
 * Vorschau an den Kunden raus, offene Punkte werden direkt besprochen statt
 * auf der Seite selbst als Warnung angezeigt.
 */
type Props = { text: string };
const { text } = Astro.props;

const teile = text.split(/(\[\[BESTÄTIGEN:?[^\]]*\]\])/g).filter((t) => t !== '');
const istPlatzhalter = (t: string) => t.startsWith('[[BESTÄTIGEN');
const inhalt = (t: string) => t.replace(/^\[\[BESTÄTIGEN:?\s*/, '').replace(/\]\]$/, '').trim();
---

{
  teile.map((teil) => (istPlatzhalter(teil) ? inhalt(teil) : teil))
}
