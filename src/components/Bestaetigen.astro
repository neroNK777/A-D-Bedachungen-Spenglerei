---
/**
 * Zeigt Text an und hebt darin enthaltene [[BESTÄTIGEN: ...]]-Platzhalter
 * sichtbar hervor, damit der Kunde sie auf der Vorschau sofort findet.
 */
type Props = { text: string };
const { text } = Astro.props;

const teile = text.split(/(\[\[BESTÄTIGEN:?[^\]]*\]\])/g).filter((t) => t !== '');
const istPlatzhalter = (t: string) => t.startsWith('[[BESTÄTIGEN');
const inhalt = (t: string) => t.replace(/^\[\[BESTÄTIGEN:?\s*/, '').replace(/\]\]$/, '').trim();
---

{
  teile.map((teil) =>
    istPlatzhalter(teil) ? (
      <mark class="bestaetigen" title="Vom Kunden zu bestätigen">
        {inhalt(teil) || 'zu bestätigen'}
      </mark>
    ) : (
      <>{teil}</>
    ),
  )
}

<style>
  .bestaetigen {
    background: var(--color-ziegel-tief);
    color: var(--color-ziegel);
    border: 1px dashed color-mix(in srgb, var(--color-ziegel) 55%, transparent);
    border-radius: 2px;
    padding: 0.05em 0.35em;
    font-size: 0.92em;
  }
  /* Bewusst ohne Textpraefix: bei vier Platzhaltern je Projekt wuerde ein
     wiederholtes "zu bestätigen" die Sektion zukleistern. Der gestrichelte
     Rahmen in Ziegelrot ist eindeutig genug, den Rest erklaert der Hinweis
     ueber der Liste. */
</style>
