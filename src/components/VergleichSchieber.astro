---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  vorher?: ImageMetadata;
  nachher?: ImageMetadata;
  vorherAlt: string;
  nachherAlt: string;
  /** Erstes Projekt darf sofort laden, der Rest bleibt lazy. */
  eifrig?: boolean;
};

const { vorher, nachher, vorherAlt, nachherAlt, eifrig = false } = Astro.props;
const bilderDa = Boolean(vorher && nachher);
---

<div class="vergleich" data-vergleich style="--schnitt: 50%">
  <!-- Nachher liegt unten und ist immer voll sichtbar. -->
  <div class="vergleich__lage vergleich__lage--nachher">
    {
      nachher ? (
        <Image
          src={nachher}
          alt={nachherAlt}
          widths={[520, 900, 1400]}
          sizes="(min-width: 62rem) 60vw, 100vw"
          loading={eifrig ? 'eager' : 'lazy'}
          class="vergleich__bild"
        />
      ) : (
        <div class="platzhalter vergleich__bild">
          <span class="platzhalter__titel">Nachher</span>
          <span class="platzhalter__text">Foto folgt</span>
        </div>
      )
    }
  </div>

  <!-- Vorher liegt darueber und wird beschnitten. -->
  <div class="vergleich__lage vergleich__lage--vorher">
    {
      vorher ? (
        <Image
          src={vorher}
          alt={vorherAlt}
          widths={[520, 900, 1400]}
          sizes="(min-width: 62rem) 60vw, 100vw"
          loading={eifrig ? 'eager' : 'lazy'}
          class="vergleich__bild"
        />
      ) : (
        <div class="platzhalter platzhalter--vorher vergleich__bild">
          <span class="platzhalter__titel">Vorher</span>
          <span class="platzhalter__text">Foto folgt</span>
        </div>
      )
    }
  </div>

  <span class="vergleich__marke vergleich__marke--links" aria-hidden="true">Vorher</span>
  <span class="vergleich__marke vergleich__marke--rechts" aria-hidden="true">Nachher</span>

  <!-- Der Griff ist die Falzkante: dieselbe Sprache wie der Seitenrand. -->
  <div
    class="vergleich__griff"
    data-vergleich-griff
    role="slider"
    tabindex="0"
    aria-label={
      bilderDa
        ? 'Vergleich zwischen Vorher und Nachher. Mit den Pfeiltasten verschieben.'
        : 'Vergleich zwischen Vorher und Nachher, Fotos folgen. Mit den Pfeiltasten verschieben.'
    }
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
    aria-valuetext="Halb Vorher, halb Nachher"
  >
    <span class="vergleich__zange" aria-hidden="true"></span>
  </div>
</div>

<style>
  .vergleich {
    position: relative;
    display: grid;
    grid-template-areas: 'stapel';
    /* Die Zeile braucht eine feste Hoehe. Ohne sie richtet sie sich nach
       dem Eigenformat des Bildes, height:100% der Kinder wird zirkulaer
       und faellt auf auto zurueck - das Bild waere dann hoeher als der
       Rahmen und wuerde oben statt nach object-position beschnitten. */
    grid-template-rows: 100%;
    /* Festes Seitenverhaeltnis gegen Layout-Shift beim Nachladen. */
    aspect-ratio: 4 / 3;
    /* Ein Vergleich soll ganz ins Fenster passen. Ueber die volle Bahnbreite
       waere er auf dem Schreibtisch hoeher als der Bildschirm. Das Format
       bleibt bewusst bei 4:3: die Aufnahmen sind nahezu quadratisch, und
       ein breiteres Fenster schneidet genau das Dach weg. */
    max-width: 54rem;
    overflow: hidden;
    border-radius: var(--radius-bahn);
    background: var(--color-putz);
    touch-action: pan-y;
    user-select: none;
    cursor: ew-resize;
  }

  .vergleich__lage {
    grid-area: stapel;
    width: 100%;
    height: 100%;
  }

  .vergleich__lage--vorher {
    /* Der Beschnitt folgt der Griffposition. clip-path laeuft auf dem
       Compositor, anders als width oder clip. */
    clip-path: inset(0 calc(100% - var(--schnitt)) 0 0);
  }

  .vergleich__bild {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Auf beiden Aufnahmen liegt das Dach in der unteren Bildhaelfte. Der
       Ausschnitt wird deshalb weit nach unten gezogen, sonst vergleicht der
       Besucher zwei Wolkenhimmel. */
    object-position: center 88%;
    display: block;
  }

  .platzhalter {
    height: 100%;
  }
  .platzhalter--vorher {
    background-color: var(--color-blatt);
  }
  .platzhalter__titel {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-russ);
  }
  .platzhalter__text {
    font-size: 0.85rem;
  }

  .vergleich__marke {
    position: absolute;
    top: 0.75rem;
    z-index: 2;
    padding: 0.3rem 0.6rem;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-kalk) 78%, transparent);
    backdrop-filter: blur(6px);
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 650;
    font-stretch: 105%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-russ);
    pointer-events: none;
  }
  .vergleich__marke--links {
    left: 0.75rem;
  }
  .vergleich__marke--rechts {
    right: 0.75rem;
  }

  .vergleich__griff {
    grid-area: stapel;
    position: relative;
    z-index: 3;
    justify-self: start;
    width: 44px;
    height: 100%;
    margin-left: calc(var(--schnitt) - 22px);
    display: grid;
    place-items: center;
    cursor: ew-resize;
  }

  /* Die Trennkante: derselbe Dreiklang aus Schatten, Grat, Schatten wie
     der Falz am Seitenrand. */
  .vergleich__griff::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 5px;
    margin-left: -2.5px;
    background: linear-gradient(
      to right,
      color-mix(in srgb, black 55%, transparent) 0 1px,
      var(--color-blatt) 1px 4px,
      color-mix(in srgb, black 55%, transparent) 4px 5px
    );
  }

  .vergleich__zange {
    position: relative;
    width: 34px;
    height: 34px;
    border-radius: 2px;
    background: var(--color-ziegel);
    box-shadow: 0 2px 10px color-mix(in srgb, black 45%, transparent);
  }
  /* Zwei Pfeilkanten, aus dem Blech geschnitten. */
  .vergleich__zange::before,
  .vergleich__zange::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 6px;
    height: 6px;
    border-top: 2px solid var(--color-kalk);
    border-right: 2px solid var(--color-kalk);
  }
  .vergleich__zange::before {
    left: 8px;
    transform: translateY(-50%) rotate(-135deg);
  }
  .vergleich__zange::after {
    right: 8px;
    transform: translateY(-50%) rotate(45deg);
  }

  .vergleich__griff:focus-visible {
    outline: none;
  }
  .vergleich__griff:focus-visible .vergleich__zange {
    outline: 3px solid var(--color-ziegel);
    outline-offset: 4px;
  }

</style>
