---
import { Icon } from 'astro-icon/components';
import { berechne, DACHFORM, MATERIAL, FLAECHE } from '../data/kalkulation';

/**
 * Leichte Vorschau statt des vollen Rechners: keine Regler, keine Segmente,
 * kein eigenes Skript. Der volle, interaktive Rechner lebt unter
 * /kostenrechner (Komponente Kostenrechner.astro). Das Beispiel unten ist
 * kein erfundener Wert, sondern dieselbe Rechenfunktion mit den
 * Startwerten des Rechners.
 */
const beispiel = berechne({
  dachform: 'steildach',
  material: 'ziegel',
  umfang: 'neueindeckung',
  flaeche: FLAECHE.start,
  zusatz: [],
});
const formatiert = (wert: number) => wert.toLocaleString('de-DE');
---

<section
  class="abschnitt rechner-vorschau"
  id="kostenrechner"
  aria-labelledby="rechner-vorschau-titel"
>
  <div class="bahn">
    <div class="rechner-vorschau__innen eintritt">
      <div class="rechner-vorschau__text">
        <h2 id="rechner-vorschau-titel">Was kostet das ungefähr?</h2>
        <p>
          Dachform, Fläche, Material und Umfang eingeben, unverbindliche Preisspanne
          ablesen. Der Rechner läuft vollständig in Ihrem Browser, es wird nichts
          übertragen.
        </p>
        <a class="knopf knopf--patina" href="/kostenrechner">Kosten berechnen</a>
      </div>

      <div class="rechner-vorschau__karte">
        <p class="rechner-vorschau__etikett">
          Beispiel: {DACHFORM.steildach.titel}, {FLAECHE.start} m², {MATERIAL.ziegel.titel}
        </p>
        <p class="rechner-vorschau__summe">
          <span class="zahlen">{formatiert(beispiel.anzeige.von)} €</span>
          <span class="rechner-vorschau__bis">bis</span>
          <span class="zahlen">{formatiert(beispiel.anzeige.bis)} €</span>
        </p>
        <p class="rechner-vorschau__hinweis">
          <Icon name="ph:arrow-right" aria-hidden="true" />
          Eigene Fläche und eigenes Material ergeben eine andere Spanne.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .rechner-vorschau__innen {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .rechner-vorschau__text h2 {
    font-size: var(--text-titel);
    line-height: var(--text-titel--line-height);
    letter-spacing: var(--text-titel--letter-spacing);
    margin-bottom: 1rem;
  }
  .rechner-vorschau__text p {
    color: var(--color-kreide);
    max-width: 46ch;
    margin-bottom: 1.75rem;
  }

  .rechner-vorschau__karte {
    background: var(--color-zink);
    border: 1px solid var(--color-linie);
    border-radius: var(--radius-bahn);
    padding: clamp(1.5rem, 3vw, 2.1rem);
  }
  .rechner-vorschau__etikett {
    font-size: 0.85rem;
    color: var(--color-kreide);
    margin-bottom: 0.9rem;
  }
  .rechner-vorschau__summe {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-size: clamp(1.75rem, 1.1rem + 2.4vw, 2.4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-stretch: 108%;
  }
  .rechner-vorschau__bis {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-kreide);
  }
  .rechner-vorschau__hinweis {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-linie);
    font-size: 0.85rem;
    color: var(--color-kreide);
  }
  .rechner-vorschau__hinweis :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--color-patina);
    flex-shrink: 0;
  }

  @media (min-width: 55rem) {
    .rechner-vorschau__innen {
      grid-template-columns: 1.2fr 1fr;
      gap: 3.5rem;
    }
  }
</style>
