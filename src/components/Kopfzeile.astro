---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { betrieb, telLink } from '../data/betrieb';
import logo from '../assets/logo/ad-logo-wortmarke.png';

const navigation = [
  { titel: 'Leistungen', ziel: '/leistungen' },
  { titel: 'Projekte', ziel: '/projekte' },
  { titel: 'Kostenrechner', ziel: '/kostenrechner' },
  { titel: 'Einsatzgebiet', ziel: '/#einsatzgebiet' },
];
---

<header class="kopf">
  <div class="bahn kopf__innen">
    <a href="/" class="kopf__marke" aria-label="A&D Bedachungen und Spenglerei, zur Startseite">
      <span class="kopf__logo">
        <Image
          src={logo}
          alt=""
          widths={[296, 444]}
          sizes="(min-width: 30rem) 148px, 118px"
          loading="eager"
          fetchpriority="high"
        />
      </span>
    </a>

    <nav class="kopf__nav" aria-label="Hauptnavigation">
      {navigation.map((n) => <a href={n.ziel}>{n.titel}</a>)}
    </nav>

    <div class="kopf__aktionen">
      <a class="kopf__tel" href={telLink}>
        <Icon name="ph:phone-fill" aria-hidden="true" />
        <span>{betrieb.telefon.anzeige}</span>
      </a>
      <a class="knopf knopf--marke kopf__cta" href="/#kontakt">Anfrage stellen</a>
    </div>
  </div>
</header>

<style>
  .kopf {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    /* Der Grund wird erst beim Scrollen dicht, damit der Hero oben offen wirkt. */
    background: color-mix(in srgb, var(--color-kalk) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-linie) 70%, transparent);
  }

  .kopf__innen {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    /* Hoehe bleibt unter 80 Pixel, auch mit Schaltflaeche. */
    height: 4.25rem;
  }

  .kopf__marke {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  /* Das Logo sitzt direkt auf dem Grund. Solange die Seite dunkel war,
     brauchte es dafuer eine weisse Karte mit Schatten, weil ein Logo auf
     weissem Grund sonst wie aufgeklebt wirkte. Mit dem hellen Cremeweiss
     entfaellt dieser Notbehelf ersatzlos: kein Kasten, kein Schatten. */
  .kopf__logo {
    display: flex;
    align-items: center;
  }
  .kopf__logo :global(img) {
    display: block;
    height: 30px;
    width: auto;
  }

  .kopf__nav {
    display: none;
    gap: 1.75rem;
    font-size: 0.92rem;
  }
  .kopf__nav a {
    color: var(--color-graphit);
    transition: color 0.18s ease;
    position: relative;
    padding-block: 0.4rem;
  }
  .kopf__nav a:hover {
    color: var(--color-russ);
  }
  /* Unterstreichung als Falzlinie, nicht als Standard-Underline. */
  .kopf__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 2px;
    background: var(--color-ziegel);
    transition: right 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .kopf__nav a:hover::after {
    right: 0;
  }

  .kopf__aktionen {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .kopf__tel {
    display: none;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-russ);
  }
  .kopf__tel:hover {
    color: var(--color-ziegel);
  }
  .kopf__tel :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--color-ziegel);
  }

  /* Auf dem Telefon uebernimmt die Sticky-Leiste unten die Aktionen. */
  .kopf__cta {
    display: none;
    padding: 0.6rem 1.1rem;
    font-size: 0.88rem;
  }

  @media (min-width: 30rem) {
    .kopf__logo :global(img) {
      height: 36px;
    }
  }

  @media (min-width: 62rem) {
    .kopf__nav,
    .kopf__tel,
    .kopf__cta {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kopf__nav a::after {
      transition: none;
    }
  }
</style>
